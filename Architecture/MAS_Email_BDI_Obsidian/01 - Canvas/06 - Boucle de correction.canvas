	"nodes":[
		{"id":"c8e08713ae0908fc","type":"text","x":0,"y":-340,"width":1140,"height":180,"text":"# 06 · Correction et reprise ciblée\nCorrecting diagnostique ; Orchestrator transmet et contrôle.\nLa portée globale est une proposition soumise à validation.","color":"6"},
		{"id":"372303fe31b50a89","type":"text","x":0,"y":200,"width":350,"height":210,"text":"## Feedback utilisateur\nStyle, omission, erreur de fond, mauvais domaine ou extraction erronée.","color":"6"},
		{"id":"9014a2c0f458424e","type":"file","x":510,"y":200,"width":380,"height":220,"file":"02 - Agents/OrchestratorAgent.md","color":"4"},
		{"id":"be70e4b7d47d4e34","type":"file","x":1040,"y":200,"width":380,"height":220,"file":"02 - Agents/CorrectingAgent.md","color":"6"},
		{"id":"ecc2601fdccd064e","type":"text","x":1570,"y":-180,"width":380,"height":200,"text":"## Extraction erronée\nPARSER / REANALYZE.","color":"6"},
		{"id":"dc3255b289637e9d","type":"text","x":1570,"y":120,"width":380,"height":200,"text":"## Mauvaise catégorie\nDECISION / REROUTE.","color":"6"},
		{"id":"7fee56705b13bcbe","type":"text","x":1570,"y":420,"width":380,"height":200,"text":"## Fond absent ou erroné du plan\nWRITER / REVISE_PLAN.","color":"6"},
		{"id":"e96af52843574e65","type":"text","x":1570,"y":720,"width":380,"height":200,"text":"## Style ou omission du brouillon\nSi le fait est déjà dans le plan : SCRIBE / REWRITE_DRAFT.","color":"6"},
		{"id":"6439b4911a0c4deb","type":"file","x":2100,"y":200,"width":400,"height":260,"file":"04 - Contrats JSON/CorrectionPlan.md","color":"6"},
		{"id":"18950b6d4f2cbc03","type":"text","x":2660,"y":200,"width":400,"height":250,"text":"## Orchestrator · Reprise\nContrôle cible, portée et autorisations.\nSollicite l’étape concernée ; réexamine les résultats dépendants.","color":"4"},
		{"id":"22806fe0a7adabf4","type":"text","x":2100,"y":730,"width":400,"height":260,"text":"## Portée sémantique few-shot\nDRAFT / THREAD / GLOBAL proposé.\nMémoire durable : choix explicite K_perso, K_commun ou nulle part.","color":"2"},
		{"id":"956bcc5865a2a445","type":"text","x":2660,"y":730,"width":400,"height":230,"text":"## Nouveau brouillon\nPrésenter à l’utilisateur.\nAncienne approbation invalide si la version a changé.","color":"6"},
		{"id":"9ebd117f434a025c","type":"text","x":1040,"y":1030,"width":910,"height":200,"text":"## Ambiguïté ou document requis\nQuestion à l’administration / Orchestrator ; pas d’accès documentaire ajouté implicitement.","color":"2"},
		{"id":"fe240310414e572d","type":"file","x":2100,"y":1140,"width":400,"height":220,"file":"05 - Conception/Suivi des taches et reprise.md","color":"2"}
	],
